<div class="Section1">

  <!-- Document Title -->
  <h1>Week 2 Demonstration Video Description & Walkthrough</h1>

  <!-- Metadata Overview Box -->
  <div class="meta-box">
    <table class="meta-table">
      <tr>
        <td class="meta-label">Project Title:</td>
        <td class="meta-value"><strong>Talent Resource Management System (TalentRMG)</strong></td>
      </tr>
      <tr>
        <td class="meta-label">Milestone / Window:</td>
        <td class="meta-value">Week 2 of 4 (Sprint Milestone 2 Deliverable)</td>
      </tr>
      <tr>
        <td class="meta-label">Presenter / Lead:</td>
        <td class="meta-value"><strong>Ajmal Thaju</strong> (Engineer / Employee & RMG Admin)</td>
      </tr>
      <tr>
        <td class="meta-label">Assigned Scope:</td>
        <td class="meta-value">Actor 1 (Engineer Portal) & Actor 2 (Manager Validation & Reminders)</td>
      </tr>
      <tr>
        <td class="meta-label">Target Duration:</td>
        <td class="meta-value"><strong>04:50 Minutes</strong> (Evaluation Target: 4:00 – 5:00 min)</td>
      </tr>
      <tr>
        <td class="meta-label">Test & Quality Suite:</td>
        <td class="meta-value"><strong>39 / 39 Automated Tests Passing</strong> | 86.4% Backend Coverage | 100% Rule 2.7 (&le; 200 lines)</td>
      </tr>
      <tr>
        <td class="meta-label">GitHub Repository:</td>
        <td class="meta-value"><a href="https://github.com/ajmalthajuaworks/talent-rmg-app">https://github.com/ajmalthajuaworks/talent-rmg-app</a> (Branches: <code>main</code>, <code>dev</code>)</td>
      </tr>
    </table>
